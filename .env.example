# SideQuests.io — environment variables
# Copy this file to `.env` (or `.env.local`) and fill in your Supabase project values.
# These are exposed to the client by Vite, so ONLY ever put public keys here.
# NEVER put a Supabase service_role key in a VITE_* variable — it would be shipped to the browser.

# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project "anon"/"publishable" public API key (safe for the browser).
VITE_SUPABASE_ANON_KEY=
