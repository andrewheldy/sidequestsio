# SideQuests.io — environment variables
# Copy this file to `.env.local` and fill in your values.
# These are VITE_* variables exposed to the client — ONLY use public/publishable keys here.
# NEVER put a Supabase service_role key or any secret in a VITE_* variable.
#
# The app runs fully without these variables using an in-browser LocalRepository
# (localStorage) seeded with demo data — ideal for development and demos.
# To switch to the production Supabase backend, fill in the values below.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Your Supabase project "anon"/"publishable" public API key (safe for the browser).
VITE_SUPABASE_ANON_KEY=

# ── Mapbox ────────────────────────────────────────────────────────────────────
# Public Mapbox token (starts with pk.) — safe for the browser.
# Get yours at https://account.mapbox.com/access-tokens/
# Set this in Vercel → Project Settings → Environment Variables for production.
VITE_MAPBOX_PUBLIC_TOKEN=
