# All EXPO_PUBLIC_* values are embedded in the client; never use privileged keys.
APP_VARIANT=development
# Obtain approved development identifiers; do not substitute production IDs.
# MOBILE_IOS_BUNDLE_IDENTIFIER=<approved-development-ios-id>
# MOBILE_ANDROID_APPLICATION_ID=<approved-development-android-id>
# Optional: Android map tiles. Without it Android shows the list view only.
# MOBILE_ANDROID_GOOGLE_MAPS_API_KEY=<restricted-android-maps-key>
#
# Backend: an approved NON-production Supabase project for this variant.
# The app refuses the production project ref and shows a setup screen instead.
# EXPO_PUBLIC_SUPABASE_URL=https://<development-project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<development-publishable-or-anon-key>
# Website origin used for policy links and accepted quest-code hosts.
# EXPO_PUBLIC_WEB_ORIGIN=https://miamisidequests.io
#
# Feature flags (docs/product/LOCATION_DISCOVERY.md). Both stay off until the
# backend has migrations 0023–0025 and their release gates pass:
# EXPO_PUBLIC_FEATURE_NEARBY=on      # location-ranked discovery at /nearby
# EXPO_PUBLIC_FEATURE_ADVENTURE=on   # Adventure nudges and geofences
# Native build input (read by app.config.ts, not shipped as JS):
# MOBILE_BACKGROUND_LOCATION=1   # adds background location; omit for a foreground-only build
# For staging: set APP_VARIANT=staging and use separately approved staging IDs
# and the staging Supabase project. Production is blocked.
